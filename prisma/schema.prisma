generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {

  id                    Int              @id @default(autoincrement())
  fullName              String           @map("full_name") @db.VarChar(100)
  email                 String           @unique @db.VarChar(100)
  passwordHash          String           @map("password_hash") @db.VarChar(255)
  role                  Role             @default(PATIENT)
  phone                 String?          @db.VarChar(20)
  dob                   String?          @db.VarChar(20)
  gender                String?          @default("Nam")
  address               String?          @db.VarChar(255)
  avatar                String?          @db.Text
  status                String           @default("Hoạt động")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  appointmentsAsDoctor  Appointment[]    @relation("DoctorAppointments")
  appointmentsAsPatient Appointment[]    @relation("PatientAppointments")
  doctorProfile         DoctorProfile?
  patientProfile        PatientProfile?
  examinationsAsDoctor  Examination[]    @relation("DoctorExaminations")
  examinationsAsPatient Examination[]    @relation("PatientExaminations")
  healthMetric          HealthMetric?
  labTests              LabTest[]
  prescriptionsAsDoctor Prescription[]   @relation("DoctorPrescriptions")
  prescriptions         Prescription[]   @relation("PatientPrescriptions")
  invoicesAsPatient     Invoice[]        @relation("PatientInvoices")
  invoicesAsDoctor      Invoice[]        @relation("DoctorInvoices")
  notifications         Notification[]

  @@map("users")
}

model PatientProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  patientCode String? @default("BN-NEW")
  cccd        String? @db.VarChar(20)
  bhyt        String? @db.VarChar(30)
  insurance   String? @db.VarChar(100)
  noShowCount Int     @default(0)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  specialty    String
  experience   String
  status       String  @default("Đang làm việc")
  rating       Float   @default(5)
  price        Int     @default(150000)
  imagePrefix  String  @default("D")
  degree       String? @default("Thạc sĩ Y Khoa")
  university   String? @default("Đại học Y Hà Nội")
  languages         String? @default("Việt, Anh")
  certificates      Json?
  bio               String? @db.Text
  certificateNumber String? @db.VarChar(100)
  doctorCode        String? @db.VarChar(20)
  schedule          Json?
  user              User    @relation(fields: [userId], references: [id])
}

model HealthMetric {
  id              Int      @id @default(autoincrement())
  patientId       Int      @unique
  heartRate       Int?     @default(75)
  bloodPressure   String?  @default("120/80")
  temperature     Float?   @default(36.8)
  weight          Float?   @default(65)
  height          Float?   @default(170)
  bmi             Float?   @default(22.5)
  bloodType       String   @default("Chưa xác định")
  allergies       String   @default("Không có")
  healthStatus    String   @default("Bình thường")
  medicalHistory  String?  @db.Text
  aiScore         Int      @default(90)
  aiMessage       String   @default("Sức khỏe ổn định.")
  updatedAt       DateTime @updatedAt
  respiratoryRate Int?     @default(18)
  spO2            Int?     @default(98)
  patient         User     @relation(fields: [patientId], references: [id])
}

model Appointment {
  id              Int          @id @default(autoincrement())
  patientId       Int
  doctorId        Int
  appointmentCode String?      @unique
  queueNumber     String?
  specialty       String
  bookingDate     String
  bookingTime     String
  room            String?
  reason          String?      @db.Text
  status          String       @default("CHỜ XÁC NHẬN")
  paymentMethod   String       @default("TẠI QUẦY")
  paymentStatus   String       @default("CHƯA THANH TOÁN")
  createdAt       DateTime     @default(now())
  doctor          User         @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient         User         @relation("PatientAppointments", fields: [patientId], references: [id])
  examination     Examination?
  invoice         Invoice?

  @@index([doctorId], map: "Appointment_doctorId_fkey")
  @@index([patientId], map: "Appointment_patientId_fkey")
}

model Examination {
  id             Int         @id @default(autoincrement())
  appointmentId  Int         @unique
  patientId      Int
  doctorId       Int
  symptoms       String      @db.Text
  medicalHistory String?     @db.Text
  diagnosis          String      @db.Text
  secondaryDiagnosis String?     @db.Text
  treatment          String?     @db.Text
  notes              String?     @db.Text
  followUpDate   String?     @db.VarChar(20)
  followUpTime   String?     @db.VarChar(20)
  followUpReason String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  clinicalExam   String?     @db.Text
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  doctor         User        @relation("DoctorExaminations", fields: [doctorId], references: [id])
  patient        User        @relation("PatientExaminations", fields: [patientId], references: [id])

  @@index([doctorId], map: "Examination_doctorId_fkey")
  @@index([patientId], map: "Examination_patientId_fkey")
}

model Prescription {
  id           Int                @id @default(autoincrement())
  patientId    Int
  doctorId     Int?
  code         String
  diagnosis    String?
  symptoms     String?            @db.Text
  treatment    String?            @db.Text
  notes        String?            @db.Text
  type         String?            @default("Ngoại trú")
  followUpDate String?
  status       String             @default("Chờ phát")
  createdAt    DateTime           @default(now())
  doctor       User?              @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  patient      User               @relation("PatientPrescriptions", fields: [patientId], references: [id])
  items        PrescriptionItem[]

  @@index([doctorId], map: "Prescription_doctorId_fkey")
  @@index([patientId], map: "Prescription_patientId_fkey")
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  medicationName String
  dosage         String
  instructions   String
  remaining      String
  statusText     String
  iconType       String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId], map: "PrescriptionItem_prescriptionId_fkey")
}

model LabTest {
  id         Int      @id @default(autoincrement())
  patientId  Int
  testName   String
  date       DateTime
  doctorName String
  result     String
  statusType String
  testsDetail Json?
  notes      String?  @db.Text
  patient    User     @relation(fields: [patientId], references: [id])

  @@index([patientId], map: "LabTest_patientId_fkey")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(255)
  user      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
}

enum Role {
  PATIENT
  DOCTOR
  RECEPTIONIST
  ADMIN
}

model Invoice {
  id              Int            @id @default(autoincrement())
  invoiceCode     String         @unique @db.VarChar(50)
  appointmentId   Int?           @unique
  patientId       Int
  doctorId        Int
  totalAmount     Int            @default(0)
  insuranceAmount Int            @default(0)
  finalAmount     Int            @default(0)
  status          String         @default("Chờ thanh toán")
  paymentMethod   String?        @db.VarChar(50)
  paymentDate     DateTime?
  paymentRef      String?        @db.VarChar(100)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patient         User           @relation("PatientInvoices", fields: [patientId], references: [id])
  doctor          User           @relation("DoctorInvoices", fields: [doctorId], references: [id])
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  items           InvoiceItem[]

  @@index([patientId], map: "Invoice_patientId_fkey")
  @@index([doctorId], map: "Invoice_doctorId_fkey")
}

model InvoiceItem {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  name       String   @db.VarChar(255)
  price      Int      @default(0)
  quantity   Int      @default(1)
  total      Int      @default(0)
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "InvoiceItem_invoiceId_fkey")
}

model OtpCode {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(100)
  code       String   @db.VarChar(10)
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email])
}
